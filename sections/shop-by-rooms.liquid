{%- comment -%}
  sections/shop-by-rooms.liquid
  Har card = ek block (Add / Remove block). Image + title + sale text par click karne se link khulta hai.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap' | stylesheet_tag }}

<style>
#sbr-{{ section.id }}{
  --sbr-bg:{{ section.settings.bg }};
  --sbr-text:{{ section.settings.text_color }};
  --sbr-sub:{{ section.settings.sub_color }};
  --sbr-radius:{{ section.settings.radius }}px;
  --sbr-gap:{{ section.settings.gap }}px;
  --sbr-scale:{{ section.settings.hover_scale | divided_by: 100.0 }};
  --sbr-opacity:{{ section.settings.hover_opacity | divided_by: 100.0 }};
  --sbr-ratio:{{ section.settings.ratio }};
  background:var(--sbr-bg);color:var(--sbr-text);font-family:'Roboto',Arial,sans-serif;
  padding:{{ section.settings.pad_top }}px 5% {{ section.settings.pad_bottom }}px;
}
#sbr-{{ section.id }} .sbr-head{text-align:center;margin-bottom:36px}
#sbr-{{ section.id }} .sbr-title{font-size:clamp(24px,3vw,32px);font-weight:700;margin:0 0 8px;color:var(--sbr-text)}
#sbr-{{ section.id }} .sbr-subtitle{font-size:14px;margin:0;color:var(--sbr-sub)}
#sbr-{{ section.id }} .sbr-grid{
  max-width:1200px;margin:0 auto;display:grid;gap:var(--sbr-gap);
  grid-template-columns:repeat({{ section.settings.cols_desktop }},1fr);
}
#sbr-{{ section.id }} .sbr-card{display:block;text-decoration:none;color:inherit;text-align:center}
#sbr-{{ section.id }} .sbr-media{
  overflow:hidden;border-radius:var(--sbr-radius);aspect-ratio:var(--sbr-ratio);background:#0000000d;
}
#sbr-{{ section.id }} .sbr-media img,#sbr-{{ section.id }} .sbr-media svg{
  width:100%;height:100%;object-fit:cover;display:block;
  transition:transform .5s ease,opacity .5s ease;
}
{%- if section.settings.hover_effect -%}
@media (hover:hover){
  #sbr-{{ section.id }} .sbr-card:hover .sbr-media img,
  #sbr-{{ section.id }} .sbr-card:hover .sbr-media svg{transform:scale(var(--sbr-scale));opacity:var(--sbr-opacity)}
}
{%- endif -%}
#sbr-{{ section.id }} .sbr-name{font-size:{{ section.settings.name_size }}px;font-weight:500;margin:14px 0 4px;color:var(--sbr-text)}
#sbr-{{ section.id }} .sbr-sale{font-size:13px;font-weight:700;margin:0;color:var(--sbr-text)}

/* Tablet */
@media (max-width:989px){
  #sbr-{{ section.id }} .sbr-grid{grid-template-columns:repeat({{ section.settings.cols_tablet }},1fr)}
  #sbr-{{ section.id }}{padding-left:4%;padding-right:4%}
}
/* Mobile */
@media (max-width:749px){
  #sbr-{{ section.id }} .sbr-grid{grid-template-columns:repeat({{ section.settings.cols_mobile }},1fr);gap:{{ section.settings.gap | times: 0.6 | round }}px}
  #sbr-{{ section.id }} .sbr-head{margin-bottom:24px}
  #sbr-{{ section.id }} .sbr-name{font-size:{{ section.settings.name_size | minus: 2 }}px;margin-top:10px}
  #sbr-{{ section.id }} .sbr-sale{font-size:12px}
}
</style>

<section id="sbr-{{ section.id }}" class="sbr">
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="sbr-head">
      {%- if section.settings.title != blank -%}<h2 class="sbr-title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="sbr-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="sbr-grid">
    {%- for block in section.blocks -%}
      {%- assign tag = 'a' -%}
      {%- if block.settings.link == blank -%}{%- assign tag = 'div' -%}{%- endif -%}
      <{{ tag }} class="sbr-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
        <div class="sbr-media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(max-width: 749px) 90vw, (max-width: 989px) 45vw, 30vw',
              alt: block.settings.image.alt | default: block.settings.name }}
          {%- else -%}
            {{ 'interior-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if block.settings.name != blank -%}<h3 class="sbr-name">{{ block.settings.name }}</h3>{%- endif -%}
        {%- if block.settings.sale != blank -%}<p class="sbr-sale">{{ block.settings.sale }}</p>{%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop By Rooms",
  "tag": "section",
  "class": "section-shop-by-rooms",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop By Rooms" },
    { "type": "text", "id": "subtitle", "label": "Subtext", "default": "Give your home an elegant touch at affordable prices" },
    { "type": "range", "id": "name_size", "label": "Card title size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#fdf0e3" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "sub_color", "label": "Subtext color", "default": "#444444" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "cols_desktop", "label": "Columns - Desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "cols_tablet", "label": "Columns - Tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "cols_mobile", "label": "Columns - Mobile", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 8, "max": 50, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "1 / 1", "options": [
      { "value": "1 / 1", "label": "Square" },
      { "value": "4 / 5", "label": "Portrait" },
      { "value": "3 / 4", "label": "Tall portrait" },
      { "value": "4 / 3", "label": "Landscape" },
      { "value": "16 / 9", "label": "Wide" }
    ] },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "Image hover effect (desktop)" },
    { "type": "checkbox", "id": "hover_effect", "label": "Enable hover effect", "default": true },
    { "type": "range", "id": "hover_scale", "label": "Hover scale (100 = no zoom)", "min": 100, "max": 130, "step": 1, "unit": "%", "default": 108 },
    { "type": "range", "id": "hover_opacity", "label": "Hover opacity", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 85 }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Title", "default": "Dining Room" },
        { "type": "text", "id": "sale", "label": "Sale text", "default": "Sale up to 40% off" },
        { "type": "url", "id": "link", "label": "Link (collection / page)", "info": "Image aur text par click karne par yahi page khulega." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Rooms",
      "blocks": [
        { "type": "room", "settings": { "name": "Dining Room", "sale": "Sale up to 40% off" } },
        { "type": "room", "settings": { "name": "Living Room", "sale": "Sale up to 30% off" } },
        { "type": "room", "settings": { "name": "Bedroom", "sale": "Sale up to 25% off" } }
      ]
    }
  ]
}
{% endschema %}